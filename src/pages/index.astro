---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import SEO from "@/components/SEO.astro";
import HeroBackground from "@/components/HeroBackground.astro";
import Sidebar from "@/components/Sidebar.astro";
import avatar from "@/images/avatar_1.webp";

const canonicalURL = new URL("/", Astro.site).href;

const [latest] = (await getCollection("blog"))
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const weight = (await getCollection("weight"))[0]?.data;
const lastWeighIn = weight?.entries.at(-1);
const goal = weight?.projection?.goal;
---

<style is:inline>
  /* Tell browsers & extensions to use appropriate color scheme for inputs */
  input.newsletter-input {
    color-scheme: light;
  }
  .dark input.newsletter-input {
    color-scheme: dark;
  }

  /*
   * Chrome forces a light-blue autofill background that can't be
   * reliably overridden. Use dark text in light mode, light text
   * in dark mode so filled values stay readable.
   */
  input.newsletter-input:-webkit-autofill,
  input.newsletter-input:-webkit-autofill:hover,
  input.newsletter-input:-webkit-autofill:focus,
  input.newsletter-input:-webkit-autofill:active {
    -webkit-text-fill-color: #1a1a1a !important;
    caret-color: #1a1a1a !important;
  }
  .dark input.newsletter-input:-webkit-autofill,
  .dark input.newsletter-input:-webkit-autofill:hover,
  .dark input.newsletter-input:-webkit-autofill:focus,
  .dark input.newsletter-input:-webkit-autofill:active {
    -webkit-text-fill-color: #f0f0f0 !important;
    caret-color: #f0f0f0 !important;
    -webkit-box-shadow: 0 0 0px 1000px oklch(21% 0 0) inset !important;
  }

  /* Floating labels: the label sits inside the field and floats up on
     focus / when filled. Inputs use placeholder=" " so :not(:placeholder-shown)
     can detect a filled value. */
  .newsletter-field {
    position: relative;
  }
  .newsletter-field input.newsletter-input {
    width: 100%;
    padding: 1.5rem 1rem 0.6rem; /* extra top room for the floated label */
    font-size: 1rem;
    line-height: 1.5;
    /* Theme via the .dark class (the site's toggle), not Tailwind's dark:
       variant, which is prefers-color-scheme based here and would not follow
       a manual theme toggle. */
    color: var(--color-gray-1200);
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
  }
  .dark .newsletter-field input.newsletter-input {
    background: var(--color-gray-200);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .newsletter-field label {
    position: absolute;
    left: 1rem;
    top: 1.05rem;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-gray-800);
    pointer-events: none;
    transition: all 0.15s ease;
  }
  /* Float on focus, when filled, and on browser autofill. The autofill
     selectors are essential: Chrome can fill a value without triggering
     :placeholder-shown, which would leave the label overlapping the text. */
  .newsletter-field input.newsletter-input:focus + label,
  .newsletter-field input.newsletter-input:not(:placeholder-shown) + label,
  .newsletter-field input.newsletter-input:-webkit-autofill + label,
  .newsletter-field input.newsletter-input:autofill + label {
    top: 0.5rem;
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--color-gray-1100);
  }
</style>

<Layout>
  <SEO
    slot="head"
    title="Daniel Noworyta"
    description="Self-taught developer, ten years in automotive before that. Writing about building software with AI from inside the work, while it is still happening."
    canonicalURL={canonicalURL}
    type="website"
  />
  <HeroBackground variant="dots" />
  <div class="px-(--inline-padding)">
    <div class="mx-auto max-w-4xl">
      <!-- Hero: the person first -->
      <Sidebar
        sidebarWidth="240px"
        noStretch
        class="pt-6 tablet:pt-14 tablet:[--sidebar-gap:3.5rem]"
      >
        <div class="max-w-60 tablet:max-w-none">
          <Image
            loading="eager"
            src={avatar}
            alt="Daniel Noworyta"
            class="aspect-square w-full rounded-lg block"
          />
        </div>
        <div class="max-w-2xl">
          <p class="caption text-gray-1000 mb-5">
            Daniel Noworyta. Full-stack dev in Poland. Self-taught in 2020.
          </p>
          <h1 class="font-medium tracking-tight text-balance">
            I started <span class="bg-brand-gradient bg-clip-text text-transparent">over once.</span>
          </h1>
          <p class="mt-6 text-lg text-pretty text-gray-1100 max-w-[52ch]">
            Ten years modeling car surfaces. Then two and a half years of 4:30
            alarms until someone paid me to write TypeScript. That was 2020.
            Now I work full-stack, web and mobile, from home in Poland, and the craft I
            fought for is being rewritten by AI faster than I expected. I write
            about what that is actually like, from inside it, while it is still
            happening.
          </p>
        </div>
      </Sidebar>

      <!-- Latest writing -->
      {
        latest && (
          <section class="mt-16 tablet:mt-24 max-w-2xl" aria-labelledby="latest">
            <p id="latest" class="caption text-gray-1000 mb-3">
              Latest
            </p>
            <a href={`/blog/${latest.data.slug}`} class="group block">
              <h2 class="text-2xl! leading-7! tablet:text-3xl! tablet:leading-8.5! font-medium group-hover:bg-brand-gradient group-hover:bg-clip-text group-hover:text-transparent transition-colors">
                {latest.data.title}
              </h2>
              <p class="mt-3 text-gray-1100 text-pretty">
                {latest.data.description}
              </p>
              <span class="mt-3 inline-block text-orange-500 font-display font-medium">
                Read it
              </span>
            </a>
          </section>
        )
      }

      <!-- Right now: the pieces that prove the brand -->
      <section class="mt-16 tablet:mt-20" aria-labelledby="now">
        <p id="now" class="caption text-gray-1000 mb-4">Right now</p>
        <ul class="grid gap-x-8 gap-y-6 tablet:grid-cols-3 text-pretty">
          {
            lastWeighIn && (
              <li>
                <p class="text-gray-1200">
                  Weighing in every morning.
                  <span class="tabular-nums">{lastWeighIn.value} {weight?.unit}</span>
                  today{goal ? `, aiming for ${goal}` : ""}, logged in public.
                </p>
                <a href="/habits" class="mt-2 inline-block text-orange-500 font-display font-medium">
                  See the habits log
                </a>
              </li>
            )
          }
          <li>
            <p class="text-gray-1200">
              Talking through all of this on YouTube, in English since this year.
            </p>
            <a
              href="https://youtube.com/@danielnoworyta"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-block text-orange-500 font-display font-medium"
            >
              Watch the channel
            </a>
          </li>
          <li>
            <p class="text-gray-1200">The longer story, Detroit included.</p>
            <a href="/about" class="mt-2 inline-block text-orange-500 font-display font-medium">
              About me
            </a>
          </li>
        </ul>
      </section>

      <!-- Newsletter -->
      <section
        class="mt-16 tablet:mt-24 max-w-2xl"
        aria-labelledby="newsletter"
      >
        <h2
          id="newsletter"
          class="text-2xl! leading-7! tablet:text-3xl! tablet:leading-8.5! font-medium text-balance"
        >
          One email a week, from inside the work.
        </h2>
        <p class="mt-3 text-gray-1100 text-pretty max-w-[52ch]">
          What I built with AI this week, what broke, and what I am changing
          about how I work because of it. No roundups of other people's threads.
        </p>
        <form
          class="mt-8 flex flex-col gap-3 w-full max-w-xs"
          action="https://app.kit.com/forms/9259766/subscriptions"
          method="post"
        >
          <div class="newsletter-field">
            <input
              type="text"
              id="sp-name"
              name="fields[first_name]"
              placeholder=" "
              class="newsletter-input rounded-lg focus:outline-2 focus:outline-orange-500 focus:-outline-offset-1"
            />
            <label for="sp-name">First name</label>
          </div>
          <div class="newsletter-field">
            <input
              type="email"
              id="sp-email"
              name="email_address"
              placeholder=" "
              required
              class="newsletter-input rounded-lg focus:outline-2 focus:outline-orange-500 focus:-outline-offset-1"
            />
            <label for="sp-email">Email address</label>
          </div>
          <input
            type="hidden"
            name="tags[]"
            id="sp-source-tag"
            value="18401031"
          />
          <button
            type="submit"
            class="mt-1 rounded-lg bg-brand-gradient px-4 py-3.5 text-sm font-display font-medium text-white transition-opacity hover:opacity-90 cursor-pointer"
          >
            Get the next one
          </button>
        </form>
        <script>
          const refToTag: Record<string, string> = {
            linkedin: "18400332",
            youtube: "18400334",
            x: "18400335",
          };
          const ref = new URLSearchParams(window.location.search).get("ref");
          if (ref && refToTag[ref]) {
            document
              .getElementById("sp-source-tag")!
              .setAttribute("value", refToTag[ref]);
          }
        </script>
        <p class="mt-3 text-gray-800 text-sm">
          I respect your privacy. Unsubscribe at any time.
        </p>
      </section>
    </div>
  </div>
</Layout>
