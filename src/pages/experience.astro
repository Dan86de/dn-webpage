---
import Layout from "@/layouts/Layout.astro";
import VaillantLogo from "@/images/vaillant_logo.svg";
import BechtleLogo from "@/images/bechtle_logo.svg";
import CodeIcon from "@/images/icons/code.svg";
import ReactIcon from "@/images/icons/react.svg";
import NextJSIcon from "@/images/icons/nextjs.svg";
import VercelIcon from "@/images/icons/vercel.svg";
import TypeScriptIcon from "@/images/icons/ts.svg";
import JavaScriptIcon from "@/images/icons/js.svg";
import NodeJsIcon from "@/images/icons/nodejs.svg";
import BunIcon from "@/images/icons/bun.svg";
import TailwindCSSIcon from "@/images/icons/tailwindcss.svg";
import ShadCnUIIcon from "@/images/icons/shadcnui.svg";
import RadixUIIcon from "@/images/icons/radixui.svg";
import MotionIcon from "@/images/icons/motion.svg";
import TanstackIcon from "@/images/icons/tanstack.svg";
import OpenAIIcon from "@/images/icons/openai.svg";
import RedisIcon from "@/images/icons/redis.svg";
import ClaudeIcon from "@/images/icons/claude.svg";
import SQLIcon from "@/images/icons/sql.svg";
import PNPMIcon from "@/images/icons/pnpm.svg";
import DockerIcon from "@/images/icons/docker.svg";
import ReactNativeIcon from "@/images/icons/reactnative.svg";
import PrismaIcon from "@/images/icons/prisma.svg";
import NestJSIcon from "@/images/icons/nestjs.svg";
import PythonIcon from "@/images/icons/python.svg";
import WorkExperience from "@/components/experience/WorkExperience.astro";
import Position from "@/components/experience/Position.astro";
import PixelCard from "@/components/PixelCard.astro";
import SEO from "@/components/SEO.astro";
import CarIcon from "@/images/icons/car.svg";

const canonicalURL = new URL("/experience", Astro.site).href;
---

<Layout>
  <SEO
    slot="head"
    title="Experience - Daniel Noworyta"
    description="Two jobs in software and the decade in automotive before them. What I actually built at each, not the CV version."
    canonicalURL={canonicalURL}
    type="website"
  />
  <div class="px-(--inline-padding)">
    <div class="mx-auto max-w-4xl">
      <h2 class="pb-4 bg-brand-gradient bg-clip-text text-transparent transition-colors" id="experience">Experience</h2>
      <p class="pb-10 text-gray-1100 text-lg max-w-2xl text-pretty">
        Two jobs in software, and the decade before them that explains why I
        take the work seriously. What I actually built at each, not the CV
        version.
      </p>
      <!-- Vaillant -->
      <div class="max-w-4xl border-b border-b-gray-200 mb-3">
        <WorkExperience companyName="Vaillant Group" isCurrentJob={true}>
          <VaillantLogo width={24} height={32} slot="logo" />
          <Position
            slot="positions"
            title="React Native Developer"
            employmentType="Full-Time"
            startDate="05-2024"
            endDate="now"
          >
            <CodeIcon width={18} slot="icon" />
            <div class="pl-8 pb-4 max-w-3xl" slot="description">
              <p class="text-gray-1200 underline pb-2 text-sm">
                myVaillantPRO, the web and mobile app that heat pump and boiler
                installers use every day
              </p>
              <ul class="list-disc pl-5 text-gray-1100 text-sm stack" style="--stack-space: 0.5rem">
                <li>
                  I build it in React and React Native. One codebase, two
                  platforms, and the bugs that only show up on one of them.
                </li>
                <li>
                  The features I am proudest of are the small ones nobody
                  planned. Drag and drop for a step installers repeated every
                  day went in on top of a sprint goal, not instead of it, and
                  saved them minutes a day.
                  <a href="/writing/ship-something-every-sprint" class="underline underline-offset-4 decoration-orange-500 hover:text-orange-500 transition-colors">That one became a post.</a>
                </li>
                <li>
                  I sit between business and design while a feature is still
                  being shaped, and I am the one saying what the platform can
                  and cannot do before anyone commits to a date.
                </li>
                <li>
                  I am also the person on the team pushing AI tools into daily
                  work. Which ones, for what, and where they still guess.
                </li>
              </ul>
            </div>
          </Position>
        </WorkExperience>
      </div>

      <!-- Bechtle -->
      <div class="max-w-4xl border-b border-b-gray-200 mb-3">
        <WorkExperience companyName="Bechtle / AV360" isCurrentJob={false}>
          <BechtleLogo width={24} height={32} slot="logo" />
          <Position
            slot="positions"
            title="Software Developer"
            employmentType="Full-Time"
            startDate="12-2020"
            endDate="05-2024"
          >
            <CodeIcon width={18} slot="icon" />
            <div class="pl-8 pb-4 max-w-3xl" slot="description">
              <p class="text-gray-1200 underline pb-2 text-sm">
                My first developer job, after two and a half years of learning
                before and after an automotive day job
              </p>
              <ul class="list-disc pl-5 text-gray-1100 pb-3 text-sm stack" style="--stack-space: 0.5rem">
                <li>
                  Built the interface for a document management platform in
                  React, FluentUI, and TypeScript. The tables held more rows
                  than the browser wanted to render, so I replaced the naive
                  lists with infinite scrolling and pagination.
                </li>
                <li>
                  Set up the testing strategy with Jest and snapshot tests,
                  because we kept breaking things we had already fixed.
                </li>
              </ul>
              <p class="text-gray-1200 underline pb-2 text-sm">
                A chat app that started as my proposal and ended up in the
                product catalogue
              </p>
              <ul class="list-disc pl-5 text-gray-1100 text-sm pb-4 stack" style="--stack-space: 0.5rem">
                <li>
                  Proposed, then built, a multi-platform chat app in Tauri on
                  the open Matrix protocol, with a rich text editor on Lexical.
                </li>
                <li>
                  Put the Tauri and Rust builds on an Azure CI/CD pipeline so a
                  release stopped depending on one person's laptop.
                </li>
              </ul>
            </div>
          </Position>
        </WorkExperience>
      </div>

      <!-- Automotive -->
      <div class="max-w-4xl border-b border-b-gray-200 mb-8">
        <WorkExperience companyName="Automotive" isCurrentJob={false}>
          <Position
            slot="positions"
            title="Class A Surface Modeler"
            employmentType="Full-Time"
            startDate="2012"
            endDate="2020"
          >
            <CarIcon width={18} slot="icon" />
            <div class="pl-8 pb-4 max-w-3xl" slot="description">
              <p class="text-gray-1200 underline pb-2 text-sm">
                Ten years before the code, and the most important line on this
                page
              </p>
              <ul class="list-disc pl-5 text-gray-1100 text-sm stack" style="--stack-space: 0.5rem">
                <li>
                  Class A surfacing is the visible skin of a car, built to a
                  tolerance you can feel with a fingertip, in software most
                  developers have never heard of.
                </li>
                <li>
                  Long stretches on site in Detroit, Turin, Sweden, and
                  Germany. That is where the discipline came from, and also
                  why I left.
                  <a href="/about#detroit" class="underline underline-offset-4 decoration-orange-500 hover:text-orange-500 transition-colors">The longer story.</a>
                </li>
              </ul>
            </div>
          </Position>
        </WorkExperience>
      </div>

      <h2 class="pb-6 bg-brand-gradient bg-clip-text text-transparent transition-colors" id="stack">Stack</h2>
      <div class="cluster" style={{ "--cluster-space": "0" }}>
        <PixelCard to="https://react.dev" variant="react" className="hover:z-10 w-20 aspect-square" tooltipText="React">
          <ReactIcon class="text-[#087EA4] [.dark_&]:text-[#58C4DC] size-8" />
        </PixelCard>
        <PixelCard tooltipText="TypeScript" to="https://www.typescriptlang.org/" variant="ts" className="hover:z-10 w-20 aspect-square">
          <TypeScriptIcon class="text-[#3178C6] size-8" />
        </PixelCard>
        <PixelCard tooltipText="NextJS" to="https://nextjs.org/" variant="default" className="hover:z-10 w-20 aspect-square">
          <NextJSIcon class="text-gray-950 size-10" />
        </PixelCard>
        <PixelCard tooltipText="Vercel" to="https://vercel.com/" variant="default" className="hover:z-10 w-20 aspect-square">
          <VercelIcon class="text-gray-950 size-8" />
        </PixelCard>
        <PixelCard tooltipText="JavaScript" to="https://developer.mozilla.org/en-US/docs/Web/JavaScript" variant="js" className="hover:z-10 w-20 aspect-square">
          <JavaScriptIcon class="text-[#f7df1e] size-8" />
        </PixelCard>
        <PixelCard tooltipText="NodeJS" to="https://nodejs.org/en/" variant="nodejs" className="hover:z-10 w-20 aspect-square">
          <NodeJsIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Bun" to="https://bun.sh/" variant="bun" className="hover:z-10 w-20 aspect-square">
          <BunIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Tailwind CSS" to="https://tailwindcss.com/" variant="tailwindcss" className="hover:z-10 w-20 aspect-square">
          <TailwindCSSIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Shadcn UI" to="https://ui.shadcn.com/" variant="default" className="hover:z-10 w-20 aspect-square">
          <ShadCnUIIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Radix UI" to="https://www.radix-ui.com/" variant="default" className="hover:z-10 w-20 aspect-square">
          <RadixUIIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Motion" to="https://motion.dev" variant="motion" className="hover:z-10 w-20 aspect-square">
          <MotionIcon class="size-10" />
        </PixelCard>
        <PixelCard tooltipText="TanStack" to="https://tanstack.com" variant="tanstack" className="hover:z-10 w-20 aspect-square">
          <TanstackIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="OpenAI" to="https://openai.com" variant="default" className="hover:z-10 w-20 aspect-square">
          <OpenAIIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Redis" to="https://redis.io" variant="redis" className="hover:z-10 w-20 aspect-square">
          <RedisIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Claude Code" to="https://claude.ai" variant="claude" className="hover:z-10 w-20 aspect-square">
          <ClaudeIcon class="text-[#D97757] size-8" />
        </PixelCard>
        <PixelCard tooltipText="PostgreSQL" to="https://www.postgresql.org" variant="sql" className="hover:z-10 w-20 aspect-square">
          <SQLIcon class="text-[#336791] size-8" />
        </PixelCard>
        <PixelCard tooltipText="PNPM" to="https://pnpm.io" variant="pnpm" className="hover:z-10 w-20 aspect-square">
          <PNPMIcon class="size-8" />
        </PixelCard>
        <PixelCard tooltipText="Docker" to="https://www.docker.com" variant="docker" className="hover:z-10 w-20 aspect-square">
          <DockerIcon class="text-[#008fe2] size-8" />
        </PixelCard>
        <PixelCard tooltipText="React Native" to="https://reactnative.dev" variant="reactnative" className="hover:z-10 w-20 aspect-square">
          <ReactNativeIcon class="text-[#087EA4] [.dark_&]:text-[#58C4DC] size-8" />
        </PixelCard>
        <PixelCard tooltipText="Prisma" to="https://www.prisma.io" variant="default" className="hover:z-10 w-20 aspect-square">
          <PrismaIcon class="text-gray-950 size-8" />
        </PixelCard>
        <PixelCard tooltipText="NestJS" to="https://nestjs.com" variant="nestjs" className="hover:z-10 w-20 aspect-square">
          <NestJSIcon class="text-[#e0234e] size-8" />
        </PixelCard>
        <PixelCard tooltipText="Python" to="https://www.python.org" variant="python" className="hover:z-10 w-20 aspect-square">
          <PythonIcon class="size-8" />
        </PixelCard>
      </div>
    </div>
  </div>
</Layout>
