---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SEO from "@/components/SEO.astro";
import HabitGrid from "@/components/HabitGrid.astro";
import WeightChart from "@/components/WeightChart.tsx";
import { todayISO } from "@/lib/habits";

const canonicalURL = new URL("/habits", Astro.site).href;

const habits = (await getCollection("habits")).sort(
  (a, b) => a.data.order - b.data.order,
);
const today = todayISO();
const weight = (await getCollection("weight"))[0]?.data;
---

<Layout>
  <SEO
    slot="head"
    title="Habits - Daniel Noworyta"
    description="A public log of my habits: CrossFit twice a week, football once a week, clean eating every day."
    canonicalURL={canonicalURL}
    type="website"
  />
  <div class="px-(--inline-padding)">
    <div class="max-w-4xl mx-auto py-12">
      <header class="mb-12 max-w-2xl">
        <h1
          class="bg-brand-gradient bg-clip-text text-transparent font-medium pb-4"
        >
          Habits
        </h1>
        <p class="text-gray-1100 text-lg">
          Since 1 September: CrossFit twice a week, football once a week,
          clean eating every day. Logged by hand, in public, because a streak
          nobody can see is easy to quietly drop.
        </p>
      </header>

      {
        weight && weight.entries.length > 0 && (
          <section class="mb-16" aria-labelledby="weight">
            <h2
              id="weight"
              class="text-2xl! leading-7! tablet:text-3xl! tablet:leading-8.5! font-medium"
            >
              Weight
            </h2>
            <p class="text-gray-1100 mt-1 mb-6">
              Weighed every morning, before coffee. Hover the chart to scrub
              through the days.
              {weight.projection && (
                <>
                  {" "}
                  The dashed line is the projection to {weight.projection.goal}{" "}
                  {weight.unit} at a {weight.projection.intake} kcal cap. Below
                  it is ahead of plan.
                </>
              )}
            </p>
            <WeightChart
              client:visible
              points={weight.entries}
              unit={weight.unit}
              projection={weight.projection}
            />
          </section>
        )
      }

      <div class="flex flex-col gap-16">
        {
          habits.map((habit) => (
            <HabitGrid
              name={habit.data.name}
              description={habit.data.description}
              days={habit.data.days}
              today={today}
              weeklyTarget={habit.data.weeklyTarget}
            />
          ))
        }
      </div>

      <div class="mt-8 flex items-center gap-5 caption text-gray-1000">
        <span class="flex items-center gap-2">
          <span class="size-3 rounded-[3px] bg-orange-500"></span> Done
        </span>
        <span class="flex items-center gap-2">
          <span class="size-3 rounded-[3px] bg-gray-400"></span> Missed
        </span>
        <span class="flex items-center gap-2">
          <span
            class="size-3 rounded-[3px] outline-2 outline-offset-1 outline-orange-500"
          ></span> Today
        </span>
      </div>
    </div>
  </div>
</Layout>
