---
import {
  buildWeeks,
  dailyStats,
  formatLong,
  monthLabels,
  weeklyStats,
  WEEKS,
} from "@/lib/habits";
import { cn } from "@/lib/utils";

interface Props {
  name: string;
  description: string;
  days: string[];
  today: string;
  weeklyTarget?: number;
}

const { name, description, days, today, weeklyTarget } = Astro.props;

const weeks = buildWeeks(days, today);
const labels = monthLabels(weeks);
const statItems = weeklyTarget
  ? weeklyStats(days, today, weeklyTarget)
  : dailyStats(days, today);
const yearTotal = statItems[statItems.length - 1].value;

// A skipped day only counts as "missed" for a daily habit.
const dayStatus = (cell: { done: boolean; isFuture: boolean }) => {
  if (cell.done) return " · done";
  if (cell.isFuture || weeklyTarget) return "";
  return " · missed";
};

const weekdays = ["Mon", "", "Wed", "", "Fri", "", "Sun"];
---

<section class="habit" aria-labelledby={`habit-${name.toLowerCase()}`}>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <div class="max-w-md">
      <h2
        id={`habit-${name.toLowerCase()}`}
        class="text-2xl! leading-7! tablet:text-3xl! tablet:leading-8.5! font-medium"
      >
        {name}
      </h2>
      <p class="text-gray-1100 mt-1">{description}</p>
    </div>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-3 tablet:flex tablet:gap-8">
      {
        statItems.map((stat) => (
          <div class="whitespace-nowrap">
            <dt class="caption text-gray-1000">{stat.label}</dt>
            <dd class="font-display font-medium text-2xl leading-8 tabular-nums">
              {stat.value}
              <span class="caption text-gray-1000 ml-0.5">{stat.unit}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!--
    Weekday labels sit outside the scroll area so they never scroll away.
    The scroll container is RTL so it opens scrolled to the end (today) on
    narrow screens without any JavaScript. The grid inside is LTR again.
  -->
  <div class="habit-frame mt-5 flex">
    <div
      class="habit-rows w-10 shrink-0"
      style="grid-template-columns: auto"
      aria-hidden="true"
    >
      {
        weekdays.map((day, row) => (
          <span
            class="caption text-gray-1000 self-center"
            style={{ gridRow: row + 2 }}
          >
            {day}
          </span>
        ))
      }
    </div>
    <div
      class="min-w-0 overflow-x-auto [direction:rtl] [scrollbar-width:none] py-1 -my-1 pr-(--inline-padding) -mr-(--inline-padding) tablet:pr-1 tablet:-mr-1 max-tablet:[mask-image:linear-gradient(to_right,transparent,black_1.5rem)]"
    >
      <div
        class="habit-rows [direction:ltr] w-max"
        style={{ "--weeks": WEEKS }}
        role="img"
        aria-label={`${name}: ${yearTotal} days in the last year`}
      >
        {
          labels.map((month) => (
            <span
              class="caption text-gray-1000 self-end"
              style={{ gridColumn: month.column + 1, gridRow: 1 }}
            >
              {month.label}
            </span>
          ))
        }
        {
          weeks.map((week, column) =>
            week.map((cell, row) => (
              <span
                class={cn(
                  "size-(--cell) rounded-[3px]",
                  cell.done && "bg-orange-500",
                  !cell.done && !cell.isFuture && "bg-gray-400",
                  cell.isFuture && "bg-transparent",
                  cell.isToday && "outline-2 outline-offset-1 outline-orange-500",
                )}
                style={{ gridColumn: column + 1, gridRow: row + 2 }}
                title={`${formatLong(cell.date)}${dayStatus(cell)}`}
              />
            )),
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Cells are 12px and the grid scrolls on narrow screens. Once the frame is
    wide enough, cells grow so the grid spans the full width: the 40px label
    column plus 53 cells and 52 gaps of 3px.
  */
  .habit-frame {
    container-type: inline-size;
    --cell: max(12px, calc((100cqw - 40px - 52 * 3px) / 53));
  }

  /* Shared row template so the label column and the grid line up. */
  .habit-rows {
    display: grid;
    grid-template-columns: repeat(var(--weeks), var(--cell));
    grid-template-rows: 20px repeat(7, var(--cell));
    gap: 3px;
  }
</style>
