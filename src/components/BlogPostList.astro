---
import { getReadingTime } from "@/lib/readingTime";
import { categoryLabel, type ListedPost } from "@/lib/posts";

interface Props {
  posts: ListedPost[];
}

const { posts } = Astro.props;
---

<div class="space-y-0 mb-8">
  {
    posts.map((listed) => {
      const { post } = listed;
      const readingTime = getReadingTime(post.body || "");
      const formattedDate = post.data.publishDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      });

      return (
        <a
          href={`/writing/${post.data.slug}`}
          class="group block py-4 border-b border-gray-200 last:border-b-0 hover:border-gray-300 transition-colors"
        >
          <article class="flex gap-8 items-start">
            <div class="flex-1">
              <p class="caption text-gray-1000 mb-2 laptop:hidden">
                {categoryLabel(listed)} · {formattedDate} · {readingTime}
              </p>
              <h2 class="text-2xl mb-4 group-hover:bg-brand-gradient group-hover:bg-clip-text group-hover:text-transparent transition-colors">
                {post.data.title}
              </h2>
              <p class="text-base leading-relaxed">{post.data.description}</p>
            </div>
            <div class="hidden text-right text-sm shrink-0 laptop:block tabular-nums">
              <div class="mb-1 flex items-center justify-end gap-2">
                {post.data.isDraft && (
                  <span class="px-1.5 py-0.5 rounded-sm bg-orange-500 text-white text-xs caption">
                    Draft
                  </span>
                )}
                <span>{categoryLabel(listed)}</span>
              </div>
              <div>{formattedDate}</div>
              <div class="text-gray-1000">{readingTime}</div>
            </div>
          </article>
        </a>
      );
    })
  }
</div>
