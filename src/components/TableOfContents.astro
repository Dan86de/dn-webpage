---
import type { TocItem } from "@/lib/toc";

interface Props {
  toc: TocItem[];
}

const { toc } = Astro.props;
---

<div class="sticky top-20">
  <p class="caption pb-4">Table of contents</p>
  <ul id="toc-list" class="flex flex-col gap-1">
    {
      toc.map((item) => (
        <>
          <li
            data-section={item.slug}
            class="toc-item footnote cursor-pointer flex gap-2 items-center -ml-4 transition-colors"
          >
            <span class="toc-indicator block size-2 bg-orange-500 rounded-full opacity-0 transition-opacity" />
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
          {item.children.length > 0 &&
            item.children.map((child) => (
              <li
                data-section={child.slug}
                class="toc-item footnote cursor-pointer flex gap-2 items-center -ml-4 transition-colors pl-4"
              >
                <span class="toc-indicator block size-2 bg-orange-500 rounded-full opacity-0 transition-opacity" />
                <a href={`#${child.slug}`}>{child.text}</a>
              </li>
            ))}
        </>
      ))
    }
  </ul>
</div>

<script>
  // Scroll spy. One source of truth (the scroll position) instead of an
  // IntersectionObserver racing a scroll listener: the last heading whose top
  // has passed the activation line is active, and once the page is scrolled
  // to the bottom the last heading is active even if it never reaches that
  // line. That is what lets the post end without a viewport of padding.
  const ACTIVATION_OFFSET = 100; // px below the top of the viewport
  const HEADER_OFFSET = 80; // sticky header height, for link scrolling

  const tocItems = Array.from(
    document.querySelectorAll<HTMLElement>(".toc-item"),
  );
  // Only the headings the TOC lists. The page has other headings (the
  // newsletter block after a post) that must not steal the active state.
  const listed = new Set(tocItems.map((item) => item.dataset.section));
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("h2[id], h3[id]"),
  ).filter((section) => listed.has(section.id));

  function setActive(sectionId: string | null) {
    tocItems.forEach((item) => {
      const active = item.dataset.section === sectionId;
      item.classList.toggle("text-orange-500", active);
      const indicator = item.querySelector(".toc-indicator");
      indicator?.classList.toggle("opacity-0", !active);
      indicator?.classList.toggle("opacity-100", active);
    });
  }

  function currentSection(): string | null {
    if (sections.length === 0) return null;

    const atBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2;
    if (atBottom) return sections[sections.length - 1].id;

    const line = window.scrollY + ACTIVATION_OFFSET;
    let active: string | null = null;
    for (const section of sections) {
      if (section.getBoundingClientRect().top + window.scrollY <= line) {
        active = section.id;
      }
    }
    return active;
  }

  let ticking = false;
  function update() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      setActive(currentSection());
      ticking = false;
    });
  }

  tocItems.forEach((item) => {
    const link = item.querySelector("a");
    link?.addEventListener("click", (e) => {
      const target = document.getElementById(
        link.getAttribute("href")?.substring(1) ?? "",
      );
      if (!target) return;
      e.preventDefault();
      history.replaceState(null, "", `#${target.id}`);
      window.scrollTo({
        top:
          target.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET,
        behavior: "smooth",
      });
    });
  });

  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  // First paint synchronously; the frame callback is only for scrolling.
  setActive(currentSection());
</script>
